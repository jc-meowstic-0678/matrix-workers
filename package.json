{
  "name": "matrix-worker",
  "version": "0.1.0",
  "description": "Matrix homeserver running on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute my-matrix-db --file=./migrations/schema.sql",
    "db:migrate:local": "wrangler d1 execute my-matrix-db --local --file=./migrations/schema.sql",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "hono": "^4.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.66.0"
  }
}
